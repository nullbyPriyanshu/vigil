generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Users and login ====================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now())

  emailNotifications Boolean @default(true)

  memberships           Membership[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordResetToken[]
  sentInvitations       Invitation[]
  teamMemberships       TeamMember[]
  scheduleParticipants  ScheduleParticipant[]
  escalationSteps       EscalationStep[]
  acknowledgedIncidents Incident[]            @relation("AcknowledgedBy")
  resolvedIncidents     Incident[]            @relation("ResolvedBy")
  incidentEvents        IncidentEvent[]
  notifications         Notification[]
  actionTokens          ActionToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==================== Organizations and members ====================

enum Role {
  OWNER
  ADMIN
  RESPONDER
  VIEWER
}

model Organization {
  id                    String    @id @default(uuid())
  name                  String    @unique
  slug                  String    @unique
  onboardingCompletedAt DateTime?
  incidentCounter       Int       @default(0)
  createdAt             DateTime  @default(now())

  memberships        Membership[]
  refreshTokens      RefreshToken[]
  invitations        Invitation[]
  teams              Team[]
  escalationPolicies EscalationPolicy[]
  schedules          Schedule[]
  services           Service[]
  incidents          Incident[]
  monitors           Monitor[]
}

model Membership {
  id        String   @id @default(uuid())
  role      Role
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Invitation {
  id         String    @id @default(uuid())
  email      String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ==================== Teams ====================

model Team {
  id        String   @id @default(uuid())
  name      String
  slug      String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members         TeamMember[]
  services        Service[]
  schedules       Schedule[]
  escalationSteps EscalationStep[]

  @@unique([organizationId, slug])
}

model TeamMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ==================== On-call schedules ====================

enum RotationType {
  DAILY
  WEEKLY
}

model Schedule {
  id           String       @id @default(uuid())
  name         String
  timezone     String
  rotationType RotationType
  handoffDay   Int?
  handoffTime  String
  startDate    DateTime
  createdAt    DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  participants    ScheduleParticipant[]
  escalationSteps EscalationStep[]

  @@unique([organizationId, name])
}

model ScheduleParticipant {
  id       String @id @default(uuid())
  position Int

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId])
}

// ==================== Escalation policies ====================

enum EscalationTargetType {
  USER
  TEAM
  SCHEDULE
}

model EscalationPolicy {
  id          String   @id @default(uuid())
  name        String
  repeatCount Int      @default(0)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  steps    EscalationStep[]
  services Service[]

  @@unique([organizationId, name])
}

// A step notifies one user, one team or one schedule.
// targetType says which of the three id columns is filled in.
model EscalationStep {
  id           String               @id @default(uuid())
  position     Int
  delayMinutes Int
  targetType   EscalationTargetType

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  policyId String
  policy   EscalationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, position])
}

// ==================== Services and API keys ====================

model Service {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  autoResolveMinutes Int?
  createdAt          DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  escalationPolicyId String
  escalationPolicy   EscalationPolicy @relation(fields: [escalationPolicyId], references: [id], onDelete: Restrict)

  apiKeys   ApiKey[]
  alerts    Alert[]
  incidents Incident[]
  monitors  Monitor[]

  @@unique([organizationId, name])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  alerts Alert[]

  @@index([serviceId])
}

// ==================== Uptime monitors ====================

enum MonitorStatus {
  PENDING
  UP
  DOWN
}

// A URL that Vigil visits every few minutes.
// When it stops answering, an alert is raised for its service.
model Monitor {
  id              String        @id @default(uuid())
  name            String
  url             String
  intervalMinutes Int           @default(1)
  status          MonitorStatus @default(PENDING)
  failCount       Int           @default(0)
  lastCheckedAt   DateTime?
  lastResponseMs  Int?
  createdAt       DateTime      @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  checks MonitorCheck[]

  @@index([organizationId])
}

// One visit to a monitor's URL and what happened.
model MonitorCheck {
  id         String   @id @default(uuid())
  up         Boolean
  statusCode Int?
  responseMs Int
  error      String?
  checkedAt  DateTime @default(now())

  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
}

// ==================== Alerts and incidents ====================

enum Severity {
  CRITICAL
  HIGH
  LOW
}

enum AlertStatus {
  TRIGGERED
  RESOLVED
}

enum IncidentStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id             String      @id @default(uuid())
  title          String
  severity       Severity
  status         AlertStatus
  dedupKey       String?
  payload        Json
  deduplicated   Boolean     @default(false)
  idempotencyKey String?
  receivedAt     DateTime    @default(now())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@unique([serviceId, idempotencyKey])
  @@index([incidentId])
  @@index([serviceId, receivedAt])
}

model Incident {
  id          String         @id @default(uuid())
  number      Int
  title       String
  description String?
  severity    Severity
  status      IncidentStatus @default(TRIGGERED)
  dedupKey    String?
  createdAt   DateTime       @default(now())
  lastAlertAt DateTime       @default(now())

  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  currentStepPosition Int       @default(0)
  escalationRound     Int       @default(0)
  nextEscalationAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  alerts        Alert[]
  events        IncidentEvent[]
  notifications Notification[]
  actionTokens  ActionToken[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([serviceId, dedupKey])
  @@index([status, nextEscalationAt])
}

enum IncidentEventType {
  CREATED
  ACKNOWLEDGED
  RESOLVED
  AUTO_RESOLVED
  COMMENT
  ESCALATED
  NOTIFICATION_SENT
  NOTIFICATION_DELIVERED
  NOTIFICATION_FAILED
}

enum ActorType {
  USER
  SYSTEM
  INTEGRATION
}

model IncidentEvent {
  id        String            @id @default(uuid())
  type      IncidentEventType
  actorType ActorType
  message   String
  metadata  Json?
  createdAt DateTime          @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

// ==================== Incident emails ====================

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id                String             @id @default(uuid())
  status            NotificationStatus @default(SENT)
  stepPosition      Int
  providerMessageId String?            @unique
  createdAt         DateTime           @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

enum ActionType {
  ACKNOWLEDGE
  RESOLVE
}

// The Acknowledge and Resolve buttons in an incident email.
model ActionToken {
  id        String     @id @default(uuid())
  tokenHash String     @unique
  action    ActionType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
