{
  "$schema": "https://turbo.build/schema.json",
  "ui":"stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["BACKEND_URL", "NEXT_PUBLIC_WS_URL"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
